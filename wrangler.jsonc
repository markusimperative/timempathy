// Timempathy public deployment. Credentials are managed separately from this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timempathy",
  "account_id": "24c5d103d15d37986af393db6d75d5aa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timempathy-wall",
      "database_id": "ce8eb870-8f03-453f-b015-7a945d2437f1",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://timempathy.timempathy.workers.dev",
  },
  "ratelimits": [
    {
      "name": "READ_LIMIT",
      "namespace_id": "987410001",
      "simple": {
        "limit": 90,
        "period": 60,
      },
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "987410002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": false,
  },
}
