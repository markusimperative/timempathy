{
  "name": "timempathy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "node server/preview.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm test && pnpm test:wall && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect": "node scripts/inspect.mjs",
    "licenses:generate": "node scripts/licenses.mjs",
    "test:firefox": "playwright test --project=desktop-firefox",
    "test:production": "node scripts/verify-production.mjs",
    "test:wall": "node --test server/wall.test.mjs",
    "test:shared": "node scripts/verify-shared-wall.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "fastify": "5.12.3",
    "lucide-react": "1.43.0",
    "motion": "13.2.0",
    "obscenity": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "license": "UNLICENSED"
}
